{
  "name": "ingestion",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "ingestion/src",
  "projectType": "application",
  "tags": ["scope:ingestion", "type:app"],
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/ingestion",
        "main": "ingestion/src/handler.ts",
        "additionalEntryPoints": ["ingestion/src/rebuildAccount.ts"],
        "tsConfig": "ingestion/tsconfig.lib.json",
        "assets": ["ingestion/*.md"],
        "platform": "node",
        "format": ["cjs"],
        "thirdParty": true,
        "external": ["@aws-sdk/*"],
        "generatePackageJson": true
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "tsc --noEmit -p ingestion/tsconfig.lib.json",
          "tsc --noEmit -p ingestion/tsconfig.spec.json"
        ],
        "parallel": false
      }
    }
  }
}
