{
  "name": "shared",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "shared/src",
  "projectType": "library",
  "tags": ["scope:shared", "type:lib"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/shared",
        "main": "shared/src/index.ts",
        "tsConfig": "shared/tsconfig.lib.json",
        "assets": ["shared/*.md"]
      }
    },
    "test": {
      "outputs": [
        "{projectRoot}/{options.coverage.reportsDirectory}",
        "{workspaceRoot}/coverage/shared"
      ],
      "options": {
        "coverage.reportsDirectory": "../coverage/shared"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "tsc --noEmit -p shared/tsconfig.lib.json",
          "tsc --noEmit -p shared/tsconfig.spec.json"
        ],
        "parallel": false
      }
    }
  }
}
