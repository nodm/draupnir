{
  "name": "infra",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "infra",
  "projectType": "application",
  "tags": ["scope:infra", "type:app"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p infra/tsconfig.json"
      }
    },
    "build-pre-sign-up-trigger": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/infra/preSignUpTrigger",
        "main": "infra/src/preSignUpTrigger.ts",
        "tsConfig": "infra/tsconfig.json",
        "platform": "node",
        "format": ["cjs"],
        "external": ["@aws-sdk/*"],
        "generatePackageJson": true
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "dependsOn": ["build-pre-sign-up-trigger"],
      "options": {
        "command": "pulumi preview",
        "cwd": "infra"
      }
    },
    "up": {
      "executor": "nx:run-commands",
      "dependsOn": ["build-pre-sign-up-trigger"],
      "options": {
        "command": "pulumi up --yes",
        "cwd": "infra"
      }
    },
    "destroy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pulumi destroy --yes",
        "cwd": "infra"
      }
    }
  }
}
