{
  "name": "mcp",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "mcp/src",
  "projectType": "application",
  "tags": ["scope:mcp", "type:app"],
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/mcp",
        "main": "mcp/src/handler.ts",
        "additionalEntryPoints": ["mcp/src/oauth.ts"],
        "tsConfig": "mcp/tsconfig.lib.json",
        "assets": ["mcp/*.md"],
        "platform": "node",
        "format": ["cjs"],
        "thirdParty": true,
        "external": ["@aws-sdk/*", "@modelcontextprotocol/*"],
        "generatePackageJson": true
      }
    },
    "install-deps": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "outputs": ["{workspaceRoot}/dist/mcp/node_modules"],
      "options": {
        "commands": [
          "node -e \"const f='package.json',p=JSON.parse(require('fs').readFileSync(f));for(const[k,v]of Object.entries(p.dependencies))if(v.startsWith('workspace:'))delete p.dependencies[k];require('fs').writeFileSync(f,JSON.stringify(p,null,2))\"",
          "npm install --omit=dev --no-audit --no-fund --package-lock=false"
        ],
        "parallel": false,
        "cwd": "dist/mcp"
      }
    }
  }
}
